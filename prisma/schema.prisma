generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String           @id @default(cuid())
  email                     String           @unique
  name                      String
  password                  String?
  googleSub                 String?          @unique
  appleSub                  String?          @unique
  role                      UserRole         @default(USER)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  avatarUrl                 String?
  isActive                  Boolean          @default(true)
  passwordChangedAt         DateTime?
  favoriteCompetitionApiIds Int[]            @default([])
  favoriteTeamApiIds        Int[]            @default([])
  homeLeagueScope           String           @default("FAVORITES") // FAVORITES | LIGAT_HAAL | ALL — home next/last-game/predictions league filter
  colorScheme               String           @default("auto")
  theme                     String           @default("modern")
  notifyGoals               Boolean          @default(true)
  notifyResults             Boolean          @default(true)
  notifyReminders           Boolean          @default(true)
  notifyNews                Boolean          @default(true)
  notifyOnThisDay           Boolean          @default(true)
  activityLogs              ActivityLog[]
  fetchJobs                 FetchJob[]       @relation("FetchJobInitiator")
  mergeOperations           MergeOperation[]
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  pushTokens                PushToken[]

  @@map("users")
}

model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique // ExpoPushToken[...]
  userId     String? // null = guest device (login is optional in the app)
  platform   String   @default("ios") // ios | android
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("push_tokens")
}

// Per-game dedupe state for match push notifications (goals + final result).
model GameNotificationState {
  gameId        String   @id
  lastHomeScore Int      @default(0)
  lastAwayScore Int      @default(0)
  notifiedFinal Boolean  @default(false)
  notifiedReminder Boolean @default(false)
  updatedAt     DateTime @updatedAt

  @@map("game_notification_state")
}

// Per-channel dedupe state for news push notifications. Tracks the newest
// Telegram message id we've already pushed so we never re-push the same item.
model NewsNotificationState {
  channelSlug   String   @id
  lastMessageId String
  updatedAt     DateTime @updatedAt

  @@map("news_notification_state")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the raw token emailed to the user
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  replacedAt DateTime?
  replacedBy String?
  familyId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Season {
  id                  String                        @id @default(cuid())
  year                Int                           @unique
  name                String
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  leaderboardEntries  CompetitionLeaderboardEntry[]
  competitions        CompetitionSeason[]
  fetchJobs           FetchJob[]
  headToHeadEntries   GameHeadToHeadEntry[]
  oddsSnapshots       GameOddsSnapshot[]
  oddsValues          GameOddsValue[]
  predictionSnapshots GamePredictionSnapshot[]
  predictions         GamePrediction[]
  games               Game[]
  liveSnapshots       LiveGameSnapshot[]
  mediaAssets         MediaAsset[]
  injuries            PlayerInjury[]
  sidelinedEntries    PlayerSidelinedEntry[]
  playerStats         PlayerStatistics[]
  transfers           PlayerTransfer[]
  trophies            PlayerTrophy[]
  standings           Standing[]
  coachAssignments    TeamCoachAssignment[]
  teamStats           TeamStatistics[]
  sofascoreTeamStats  SofascoreTeamStats[]
  teams               Team[]

  @@map("seasons")
}

model Competition {
  id                  String                        @id @default(cuid())
  apiFootballId       Int?                          @unique
  countryEn           String?
  countryHe           String?
  nameEn              String
  nameHe              String
  logoUrl             String?
  type                CompetitionType               @default(LEAGUE)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  leaderboardEntries  CompetitionLeaderboardEntry[]
  seasons             CompetitionSeason[]
  fetchJobs           FetchJob[]
  headToHeadEntries   GameHeadToHeadEntry[]
  oddsSnapshots       GameOddsSnapshot[]
  oddsValues          GameOddsValue[]
  predictionSnapshots GamePredictionSnapshot[]
  predictions         GamePrediction[]
  games               Game[]
  liveSnapshots       LiveGameSnapshot[]
  injuries            PlayerInjury[]
  playerStats         PlayerStatistics[]
  standings           Standing[]
  teamStats           TeamStatistics[]

  @@map("competitions")
}

model CompetitionSeason {
  id                 String      @id @default(cuid())
  competitionId      String
  seasonId           String
  stageNameEn        String?
  stageNameHe        String?
  currentRoundEn     String?
  currentRoundHe     String?
  standingsUpdatedAt DateTime?
  fixturesUpdatedAt  DateTime?
  playersUpdatedAt   DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  additionalInfo     Json?
  footyStatsSeasonId Int?
  competition        Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season             Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([competitionId, seasonId])
  @@index([seasonId])
  @@map("competition_seasons")
}

model Team {
  id                 String                        @id @default(cuid())
  nameEn             String
  nameHe             String
  logoUrl            String?
  coach              String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  seasonId           String
  additionalInfo     Json?
  apiFootballId      Int?
  cityEn             String?
  cityHe             String?
  coachHe            String?
  code               String?
  countryEn          String?
  countryHe          String?
  founded            Int?
  shortNameEn        String?
  shortNameHe        String?
  stadiumEn          String?
  stadiumHe          String?
  venueId            String?
  footyStatsId       Int?
  // Narrative + external-source enrichments. Cached blobs we refresh on a
  // schedule rather than computing on every render.
  aiSummary          Json?
  wikiInfo           Json?
  leaderboardEntries CompetitionLeaderboardEntry[]
  fetchJobs          FetchJob[]
  homeEvents         GameEvent[]                   @relation("EventTeam")
  lineupEntries      GameLineupEntry[]
  awayGames          Game[]                        @relation("AwayTeam")
  homeGames          Game[]                        @relation("HomeTeam")
  uploads            MediaAsset[]                  @relation("TeamAssets")
  injuries           PlayerInjury[]
  players            Player[]
  standings          Standing[]
  coachAssignments   TeamCoachAssignment[]
  teamStats          TeamStatistics[]
  sofascoreStats     SofascoreTeamStats[]
  season             Season                        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  venue              Venue?                        @relation("TeamVenue", fields: [venueId], references: [id])

  @@unique([nameEn, seasonId])
  @@unique([apiFootballId, seasonId])
  @@index([seasonId])
  @@index([footyStatsId])
  @@map("teams")
}

model Venue {
  id             String       @id @default(cuid())
  apiFootballId  Int?         @unique
  nameEn         String
  nameHe         String
  addressEn      String?
  addressHe      String?
  cityEn         String?
  cityHe         String?
  countryEn      String?
  countryHe      String?
  capacity       Int?
  surface        String?
  imageUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  additionalInfo Json?
  games          Game[]       @relation("GameVenue")
  uploads        MediaAsset[] @relation("VenueAssets")
  teams          Team[]       @relation("TeamVenue")

  @@index([nameEn])
  @@index([cityEn])
  @@map("venues")
}

model Referee {
  id           String   @id @default(cuid())
  nameEn       String   @unique
  nameHe       String?
  footyStatsId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  games        Game[]

  @@index([nameEn])
  @@index([footyStatsId])
  @@map("referees")
}

// Sofascore per-season team aggregate stats — fine-grained breakdowns
// (penalty goals, free-kick goals, headed goals, inside-box / outside-box
// goals, possession %, big chances, etc.) that we don't get from
// API-Football or Flashscore. Refreshed periodically via scrape.
model SofascoreTeamStats {
  id        String   @id @default(cuid())
  teamId    String
  seasonId  String
  payload   Json // flat key→value bag, see scrape-sofascore-team-stats.js
  scrapedAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@map("sofascore_team_stats")
}

// Per-match Sofascore stats from the #tab:statistics view: shots breakdown,
// duels, passes, defending, goalkeeping (~40 metrics per side). One row per
// game so re-runs upsert by gameId.
model FotmobMatchData {
  id          String   @id @default(cuid())
  gameId      String   @unique
  fotmobId    String?
  shotmap     Json? // [{isHome, player, min, outcome, xg, xgot, situation, shotType, px, py}]
  momentum    Json? // { data:[{minute,value}], goals:[{minute,isHome,player}] }
  playerStats Json? // [{isHome, name, rating, minutes, goals, assists, xg, xa, xgxa, shots, chancesCreated, defActions, isGK, stats:{<label>:value}}]
  teamStats   Json? // [{section, label, home, away}] — full team stats panel
  matchInfo   Json? // { attendance, stadium:{name,city,capacity,surface}, referee, weather:{temperature,description,...} }
  unavailable Json? // { home:[{name,nameEn,playerId,fotmobId,type:'injury'|'suspension',expectedReturn,expectedReturnDate,countryCode,age}], away:[...] }
  scrapedAt   DateTime @default(now())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("fotmob_match_data")
}

model SofascoreMatchStats {
  id        String   @id @default(cuid())
  gameId    String   @unique
  payload   Json // array of {section, label, home, away[, homePct, awayPct]}
  shotmap   Json? // array of shots: {isHome, player, min, outcome, situation, bodyPart, x, y, goalMouth:{y,z,loc}}
  matchUrl  String? // Sofascore URL we scraped from, for debugging
  scrapedAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("sofascore_match_stats")
}

// Multi-source per-match player ratings. Each (game, player, source[, user])
// combination is unique. The Best XI / Player-of-the-Round pipeline averages
// across sources to produce a unified rating per (game, player). Source values:
//   'api-football' | 'sofascore' | 'fotmob' | 'admin' | 'user'
// All ratings are normalised to a 0-10 scale at write time.
model PlayerMatchRating {
  id           String   @id @default(cuid())
  gameId       String
  playerId     String
  source       String
  sourceUserId String?
  rating       Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId, source, sourceUserId])
  @@index([gameId, playerId])
  @@index([source])
  @@map("player_match_ratings")
}

model TeamCoachAssignment {
  id                 String    @id @default(cuid())
  apiFootballCoachId Int?
  coachNameEn        String
  coachNameHe        String?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  teamId             String
  seasonId           String
  coachId            String?
  coach              Coach?    @relation(fields: [coachId], references: [id], onDelete: SetNull)
  season             Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId, coachNameEn, startDate])
  @@index([teamId, seasonId, startDate])
  @@index([seasonId, coachNameEn])
  @@index([coachId])
  @@map("team_coach_assignments")
}

model Coach {
  id                 String                @id @default(cuid())
  nameEn             String                @unique
  nameHe             String?
  photoUrl           String?
  apiFootballCoachId Int?                  @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  aliases            CoachAlias[]
  assignments        TeamCoachAssignment[]

  @@index([nameEn])
  @@map("coaches")
}

model CoachAlias {
  id      String @id @default(cuid())
  coachId String
  alias   String @unique
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@index([coachId])
  @@map("coach_aliases")
}

model Player {
  id                 String                        @id @default(cuid())
  nameEn             String
  nameHe             String
  jerseyNumber       Int?
  photoUrl           String?
  position           String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  teamId             String
  additionalInfo     Json?
  apiFootballId      Int?
  birthDate          DateTime?
  firstNameEn        String?
  firstNameHe        String?
  lastNameEn         String?
  lastNameHe         String?
  nationalityEn      String?
  nationalityHe      String?
  canonicalPlayerId  String?
  age                Int?
  footyStatsId       Int?
  birthCountryEn     String?
  birthCountryHe     String?
  birthPlaceEn       String?
  birthPlaceHe       String?
  height             String?
  isInjured          Boolean?
  weight             String?
  leaderboardEntries CompetitionLeaderboardEntry[]
  events             GameEvent[]                   @relation("PrimaryPlayer")
  relatedEvents      GameEvent[]                   @relation("RelatedPlayer")
  lineupEntries      GameLineupEntry[]
  gamePlayerStats    GamePlayerStats[]
  matchRatings       PlayerMatchRating[]
  uploads            MediaAsset[]                  @relation("PlayerAssets")
  injuries           PlayerInjury[]
  sidelinedEntries   PlayerSidelinedEntry[]
  playerStats        PlayerStatistics[]
  transfers          PlayerTransfer[]
  trophies           PlayerTrophy[]
  songs              Song[]
  canonicalPlayer    Player?                       @relation("CanonicalPlayer", fields: [canonicalPlayerId], references: [id])
  seasonEntries      Player[]                      @relation("CanonicalPlayer")
  team               Team                          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([jerseyNumber, teamId])
  @@unique([apiFootballId, teamId])
  @@index([canonicalPlayerId])
  @@index([teamId])
  @@index([footyStatsId])
  @@map("players")
}

model Game {
  id                  String                   @id @default(cuid())
  dateTime            DateTime
  homeScore           Int?
  awayScore           Int?
  status              GameStatus               @default(SCHEDULED)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  homeTeamId          String
  awayTeamId          String
  seasonId            String
  apiFootballId       Int?                     @unique
  footyStatsId        Int?                     @unique
  competitionId       String?
  externalRef         String?
  refereeEn           String?
  refereeHe           String?
  roundNameEn         String?
  roundNameHe         String?
  venueNameEn         String?
  venueNameHe         String?
  refereeId           String?
  venueId             String?
  additionalInfo      Json?
  elapsed             Int?
  extra               Int?
  statusLong          String?
  statusShort         String?
  timestamp           Int?
  timezone            String?
  awayPenalty         Int?
  homePenalty         Int?
  awayScoreRegular    Int?
  homeScoreRegular    Int?
  activityLogs        ActivityLog[]
  fetchJobs           FetchJob[]
  events              GameEvent[]
  headToHeadEntries   GameHeadToHeadEntry[]
  lineupEntries       GameLineupEntry[]
  oddsSnapshots       GameOddsSnapshot[]
  oddsValues          GameOddsValue[]
  predictionSnapshots GamePredictionSnapshot[]
  prediction          GamePrediction?
  gameStats           GameStatistics?
  gamePlayerStats     GamePlayerStats[]
  matchRatings        PlayerMatchRating[]
  sofascoreMatchStats SofascoreMatchStats?
  fotmobData          FotmobMatchData?
  awayTeam            Team                     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  competition         Competition?             @relation(fields: [competitionId], references: [id])
  homeTeam            Team                     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  referee             Referee?                 @relation(fields: [refereeId], references: [id])
  season              Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  venue               Venue?                   @relation("GameVenue", fields: [venueId], references: [id])
  liveSnapshots       LiveGameSnapshot[]
  injuries            PlayerInjury[]
  winnerOdds          WinnerOdds[]

  @@index([seasonId, competitionId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([seasonId, dateTime])
  @@index([status, dateTime])
  @@map("games")
}

model GameEvent {
  id                     String    @id @default(cuid())
  minute                 Int
  type                   EventType
  team                   String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  gameId                 String
  playerId               String?
  assistPlayerId         String?
  apiFootballId          Int?
  extraMinute            Int?
  icon                   String?
  notesEn                String?
  notesHe                String?
  relatedPlayerId        String?
  sortOrder              Int       @default(0)
  teamId                 String?
  participantName        String?
  relatedParticipantName String?
  game                   Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player                 Player?   @relation("PrimaryPlayer", fields: [playerId], references: [id])
  relatedPlayer          Player?   @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])
  eventTeam              Team?     @relation("EventTeam", fields: [teamId], references: [id])

  @@index([gameId, sortOrder])
  @@index([playerId])
  @@index([relatedPlayerId])
  @@map("game_events")
}

model GameLineupEntry {
  id              String                @id @default(cuid())
  apiFootballId   Int?
  role            GameLineupRole
  participantType LineupParticipantType @default(PLAYER)
  participantName String?
  formation       String?
  positionName    String?
  positionGrid    String?
  jerseyNumber    Int?
  rating          Float? // 0-10 per-match performance rating (Flashscore)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  gameId          String
  teamId          String
  playerId        String?
  game            Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player          Player?               @relation(fields: [playerId], references: [id])
  team            Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId, playerId, role, positionGrid])
  @@index([gameId, teamId, role])
  @@index([playerId])
  @@map("game_lineup_entries")
}

model Standing {
  id                     String       @id @default(cuid())
  position               Int
  played                 Int          @default(0)
  wins                   Int          @default(0)
  draws                  Int          @default(0)
  losses                 Int          @default(0)
  goalsFor               Int          @default(0)
  goalsAgainst           Int          @default(0)
  points                 Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  teamId                 String
  seasonId               String
  cleanSheets            Int          @default(0)
  competitionId          String
  form                   String?
  pointsAdjustment       Int          @default(0)
  pointsAdjustmentNoteHe String?
  additionalInfo         Json?
  descriptionEn          String?
  descriptionHe          String?
  goalsDiff              Int          @default(0)
  groupNameEn            String?
  groupNameHe            String?
  statusEn               String?
  statusHe               String?
  competition            Competition  @relation(fields: [competitionId], references: [id])
  season                 Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team                   Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Unique per competition: a team can hold a league row AND a cup group row in
  // the same season without one clobbering the other (code-review H7).
  @@unique([seasonId, teamId, competitionId])
  @@index([competitionId, position])
  @@index([seasonId, teamId])
  @@map("standings")
}

model PlayerStatistics {
  id                    String       @id @default(cuid())
  goals                 Int          @default(0)
  assists               Int          @default(0)
  yellowCards           Int          @default(0)
  redCards              Int          @default(0)
  gamesPlayed           Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  playerId              String
  competitionId         String?
  keyPasses             Int          @default(0)
  minutesPlayed         Int          @default(0)
  seasonId              String?
  seasonLabelEn         String?
  seasonLabelHe         String?
  shots                 Int          @default(0)
  starts                Int          @default(0)
  substituteAppearances Int          @default(0)
  timesSubbedOff        Int          @default(0)
  goalsPer90            Float?
  assistsPer90          Float?
  minPerGoal            Int?
  cardsPer90            Float?
  // Rich API-Football per-season stats
  shotsOnTarget         Int?
  passesTotal           Int?
  passesAccuracy        Int? // percent 0-100
  tacklesTotal          Int?
  tacklesBlocks         Int?
  tacklesInterceptions  Int?
  duelsTotal            Int?
  duelsWon              Int?
  foulsCommitted        Int?
  foulsDrawn            Int?
  dribblesAttempts      Int?
  dribblesSuccess       Int?
  rating                Float? // 0-10 player rating
  position              String?
  appearances           Int? // distinct from gamesPlayed (number of games where player was in squad)
  additionalInfo        Json? // raw API-Football statistics block for any extra fields
  competition           Competition? @relation(fields: [competitionId], references: [id])
  player                Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season                Season?      @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId, competitionId])
  @@index([playerId, seasonId])
  @@map("player_statistics")
}

model TeamStatistics {
  id                String       @id @default(cuid())
  totalGoals        Int          @default(0)
  totalAssists      Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  teamId            String
  cleanSheets       Int          @default(0)
  competitionId     String?
  draws             Int          @default(0)
  goalsConceded     Int          @default(0)
  losses            Int          @default(0)
  points            Int          @default(0)
  seasonId          String?
  wins              Int          @default(0)
  averagePossession Float        @default(0)
  corners           Int          @default(0)
  fouls             Int          @default(0)
  matchesPlayed     Int          @default(0)
  offsides          Int          @default(0)
  redCards          Int          @default(0)
  shotsOnTarget     Int          @default(0)
  shotsTotal        Int          @default(0)
  yellowCards       Int          @default(0)
  competition       Competition? @relation(fields: [competitionId], references: [id])
  season            Season?      @relation(fields: [seasonId], references: [id])
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId, competitionId])
  @@index([teamId, seasonId])
  @@map("team_statistics")
}

model CompetitionLeaderboardEntry {
  id                  String              @id @default(cuid())
  category            LeaderboardCategory
  rank                Int
  value               Int                 @default(0)
  gamesPlayed         Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  seasonId            String
  competitionId       String
  teamId              String?
  playerId            String?
  apiFootballPlayerId Int?
  playerNameEn        String?
  playerNameHe        String?
  teamNameEn          String?
  teamNameHe          String?
  additionalInfo      Json?
  competition         Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player              Player?             @relation(fields: [playerId], references: [id])
  season              Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team                Team?               @relation(fields: [teamId], references: [id])

  @@unique([seasonId, competitionId, category, rank])
  @@index([seasonId, competitionId, category, rank])
  @@map("competition_leaderboard_entries")
}

model GameStatistics {
  id                 String   @id @default(cuid())
  homeTeamPossession Float?
  awayTeamPossession Float?
