enum SongType {
  STAND // שיר יציע
  PLAYER // שיר שחקן
  STUDIO // שיר אולפן
  CHAMPIONSHIP // שיר אליפות
}

model Song {
  id                String   @id @default(cuid())
  slug              String   @unique
  type              SongType @default(STAND)
  titleHe           String
  lyricsHe          String?
  chordsHe          String?
  originalMelody    String? // "שיר מקור" name
  originalMelodyUrl String? // YouTube of the original
  performerGroup    String? // e.g. "אולטרס דרום"
  debutSeasonYear   Int? // start-year of debut season
  videoUrls         String[] // YouTube links
  playerId          String?
  contentWarning    Boolean  @default(false)
  isPublished       Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  player            Player?  @relation(fields: [playerId], references: [id])

  @@index([type])
  @@index([playerId])
  @@map("songs")
}

model RecordEntry {
  id         String   @id @default(cuid())
  category   String   // e.g. "biggest_win", "fastest_goal" — see records-engine CATEGORIES
  scope      String   // "league" | "club:<clubKey>"
  rank       Int
  valueNum   Float?   // sortable magnitude (margin, minute, count…)
  labelHe    String   // display line, superlative-framed
  detailHe   String?  // secondary line (date · competition · opponent)
  clubKey    String?
  playerId   String?
  gameId     String?
  seasonYear Int?
  computedAt DateTime @default(now())

  @@unique([category, scope, rank])
  @@index([scope, category])
  @@map("record_entries")
}

model StatNarrative {
  id          String   @id @default(cuid())
  questionKey String   // "<id>[:<clubKey>][:<rivalKey>]"
  dataVersion String
  text        String
  createdAt   DateTime @default(now())

  @@unique([questionKey, dataVersion])
  @@map("stat_narratives")
}
